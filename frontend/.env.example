# Base URL for the Sudoku FastAPI backend.
# Include the full path up to (and including) the versioned prefix.
#
# Development:
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1/sudoku
#
# Production example (change to your deployed URL):
# VITE_API_BASE_URL=https://my-sudoku-api.onrender.com/api/v1/sudoku
